# Puerto del API
PORT=8787

# --- OCR -------------------------------------------------------------
# OCR.space (texto general: VIN y, si no hay Plate Recognizer, matrículas).
# Plan gratuito: https://ocr.space/ocrapi  ("helloworld" es la clave demo, muy limitada)
OCRSPACE_API_KEY=helloworld

# Plate Recognizer (lector de matrículas especializado, plan gratuito mensual).
# https://platerecognizer.com
PLATE_RECOGNIZER_TOKEN=

# --- Matrícula → VIN (España) -------------------------------------------
# La DGT no ofrece API pública. RegCheck / CarRegistrationAPI tiene endpoint para España (de pago por consulta).
# https://www.regcheck.org.uk
REGCHECK_USERNAME=

# --- Datos de taller (licencia) -----------------------------------------
# Rellenar cuando haya contrato. Mientras estén vacíos, la app muestra "no configurado".
HAYNESPRO_DISTRIBUTOR=
HAYNESPRO_PASSWORD=
AUTODATA_CLIENT_ID=
AUTODATA_CLIENT_SECRET=
TECDOC_PROVIDER_ID=
TECDOC_API_KEY=
